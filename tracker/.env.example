# video-tracker — mẫu cấu hình. Sao chép thành .env rồi điền; KHÔNG commit .env.
# Sinh token: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# Dòng trống = dùng mặc định / tắt tính năng.

# --- Dữ liệu ---
# Đường dẫn file SQLite (Docker đã cố định /data/tracker.sqlite3 trong docker-compose.yml)
TRACKER_DB=
# Số video đọc mỗi kênh mỗi lần đồng bộ (mặc định 30)
TRACKER_SYNC_LIMIT=30
# Lần đồng bộ thành công cũ hơn số giờ này thì coi là "cũ" với tuần hiện tại (mặc định 36)
TRACKER_FRESH_HOURS=36

# --- Dịch vụ HTTP (tracker serve) ---
# Địa chỉ bind (mặc định 127.0.0.1; Docker đặt 0.0.0.0 và bắt buộc có token bên dưới)
TRACKER_HOST=
# Cổng (mặc định 8765)
TRACKER_PORT=8765
# Token Bearer cho /api/* (và /ingest khi không đặt TRACKER_INGEST_TOKEN); để trống thì /api trả 503.
# Mọi token phải dài ít nhất 32 ký tự, nếu không `tracker serve` từ chối chạy.
TRACKER_API_TOKEN=
# Token riêng cho máy thu thập (collect-push): khi đặt, CHỈ token này mở POST /ingest và
# GET /ingest/targets (token API không mở được nữa). Để trống = dùng TRACKER_API_TOKEN như cũ.
# collect-push ưu tiên biến này, không có thì dùng TRACKER_API_TOKEN.
TRACKER_INGEST_TOKEN=
# Token Bearer cho /mcp (HTTP); để trống thì KHÔNG mở /mcp. Dùng token khác API token
TRACKER_MCP_TOKEN=
# Hostname công khai, cách nhau dấu phẩy (vd tracker.example.com); bắt buộc khi /mcp đi qua reverse proxy
TRACKER_ALLOWED_HOSTS=

# --- Lịch chạy nền (serve --scheduler) ---
# Đồng bộ mỗi bao nhiêu giờ; 0 = tắt (mặc định 6)
TRACKER_SYNC_EVERY_HOURS=6
# Giờ gửi báo cáo, giờ VN, dạng "mon 08:00" (mon..sun hoặc t2..t7, cn); để trống = tắt.
# Báo cáo LUÔN là tuần thứ Hai–Chủ nhật vừa qua, dù chọn thứ mấy.
TRACKER_REPORT_AT=mon 08:00

# --- Nhận xét AI (tùy chọn; chỉ gửi mã học viên và số liệu, không tên/URL/tiêu đề) ---
# 1 = báo cáo có nhận xét AI; 0 = không (mặc định)
TRACKER_AI=0
# API key OpenAI (bí mật)
OPENAI_API_KEY=
# Tên model, bắt buộc nếu bật AI (thiếu thì bỏ qua AI và ghi chú trong báo cáo)
TRACKER_OPENAI_MODEL=
# Base URL API (mặc định https://api.openai.com/v1)
OPENAI_BASE_URL=

# --- Gửi báo cáo ---
# Kênh: stdout | file | webhook | command | zalo_mod (mặc định stdout = chỉ in vào log)
TRACKER_DELIVER=stdout
# Kênh file: đường dẫn file, ghi nối thêm (file mới tạo quyền 0600, thư mục mới 0700)
TRACKER_DELIVER_FILE=
# Kênh webhook: URL nhận POST JSON {"text": ...}
TRACKER_DELIVER_WEBHOOK_URL=
# Kênh webhook: Bearer token (tùy chọn, bí mật)
TRACKER_DELIVER_WEBHOOK_TOKEN=
# Kênh command: lệnh (tách bằng shlex, không qua shell), nội dung báo cáo vào stdin
TRACKER_DELIVER_COMMAND=

# --- Kênh zalo_mod (bot Zalo; CHƯA kiểm thật) ---
# URL dashboard; từ trong Docker dùng http://host.docker.internal:18792/api/action (xem docker-compose.yml)
TRACKER_ZALO_MOD_URL=http://127.0.0.1:18792/api/action
# Bearer token dashboard zalo-mod (bí mật, bắt buộc với zalo_mod)
TRACKER_ZALO_MOD_TOKEN=
# groupId/userId Zalo thô (bắt buộc với zalo_mod)
TRACKER_ZALO_TARGET_ID=
# group | user (mặc định group)
TRACKER_ZALO_TARGET_TYPE=group

# --- YouTube ---
# Có key thì collector YouTube dùng Data API v3 thay yt-dlp (bí mật; tránh bị chặn "not a bot" trên VPS)
YOUTUBE_API_KEY=
